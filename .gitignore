# Secrets et certificats propres à chaque installation : jamais dans le dépôt.
.env
*.crt
*.key
*.local.json

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Node
node_modules/

# Données brutes et outils téléchargés : hors dépôt.
*.osm.pbf
donnees/outils/
telechargements/

# Base de données et photos : propres à chaque installation.
donnees/*/signalements.sqlite*
donnees/*/photos/

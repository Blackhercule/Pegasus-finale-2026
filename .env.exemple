# Copiez ce fichier en « .env » pour lancer l'application sur un PC avec lancer-en-local.sh.
# Le fichier .env n'est jamais envoyé sur GitHub (voir .gitignore).

# Compte du patron, créé au premier lancement
PATRON_IDENTIFIANT=patron
PATRON_MOT_DE_PASSE=

# Nom affiché en haut des pages et des reçus (modifiable ensuite dans Paramètres)
NOM_CAVE=Ma cave

# « oui » pour charger des données fictives (boissons, clients, 3 mois de ventes)
DONNEES_DEMO=non

# En ligne seulement (Render les remplit tout seul) :
# SECRET_KEY=
# DATABASE_URL=postgres://utilisateur:motdepasse@serveur:5432/base
